{
  "name": "skeleton-crew",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "conformance": "node scripts/conformance/cli.ts",
    "check": "node scripts/conformance/check.ts",
    "test:conformance": "node --test \"scripts/conformance/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "worktree": "node scripts/conformance/worktree.ts",
    "test": "node --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "dev": "next dev",
    "build": "next build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "^10.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "storybook": "^10.6.8",
    "ts-api": "npm:typescript@6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
